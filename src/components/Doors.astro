---
import { contact } from "../data/site";
---
<section>
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Who it's for</p>
      <h2>Astronomy, wherever your people are</h2>
    </div>
    <div class="doors">
      <a class="door" href="#schools">
        <span class="eyebrow">For schools</span>
        <h3>Bring astronomy to your school</h3>
        <p>School Astronomy Night: telescopes, sky stories and hands-on activities for your students.</p>
        <span>See the programme →</span>
      </a>
      <a class="door" href="#groups" data-who="Apartment society / family">
        <span class="eyebrow">Private events</span>
        <h3>A night sky for your family or society</h3>
        <p>Birthdays, apartment communities and family nights with a real telescope.</p>
        <span>Plan a night →</span>
      </a>
      <a class="door" href="#groups" data-who="College or club">
        <span class="eyebrow">Colleges &amp; communities</span>
        <h3>Sessions for campuses and groups</h3>
        <p>Talks, telescope nights and astrophotography workshops for colleges, clubs and companies.</p>
        <span>Plan a session →</span>
      </a>
      <a class="door" href={contact.mainSite} target="_blank" rel="noopener">
        <span class="eyebrow">On your own</span>
        <h3>Explore the sky yourself</h3>
        <p>Free star map, planet finder and the Beyond The Sky app, in English and Telugu.</p>
        <span>Open beyondthesky.in ↗</span>
      </a>
    </div>
  </div>
</section>
