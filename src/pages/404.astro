---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found | Stargazing Hyderabad" description="This page drifted out of orbit.">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1>Lost in <em>deep space.</em></h1>
      <p class="lede">This page doesn't exist. Head back to Earth and book a night under the stars.</p>
      <div class="hero-cta"><a class="btn btn-red" href="/">Back to the home page</a></div>
    </div>
  </section>
</Base>
